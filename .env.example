# Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.

# ─── Supabase (Public — safe to use in browser) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Supabase (Server-only — NEVER expose to browser) ──────────────────────
# Used only in Route Handlers and Server Actions.
# Bypasses RLS — treat with the same care as a database password.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Application ───────────────────────────────────────────────────────────
# Set to the deployed URL in production. Used for redirects and callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase Auth Redirects ───────────────────────────────────────────────
# Callback URL for OAuth and magic links.
# In production, set to: https://your-domain.com/auth/callback
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
